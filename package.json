    "rea:inspect": "node scripts/rea.mjs inspect",
    "rea:analyze": "node scripts/rea.mjs analyze",
    "rea:search": "node scripts/rea.mjs search"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "rea-agents": "4.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
