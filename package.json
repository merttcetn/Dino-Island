{
  "name": "dino-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.19.0 || ^24.11.0 || >=26.0.0" },
  "overrides": { "smol-toml": "1.9.1" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
